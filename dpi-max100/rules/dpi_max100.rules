# dpi_max100.rules — compact protocol/service DPI rules for Suricata 8.x
# Generated/refined 2026-08-25. SIDs 9500001-9500999 are local to this bundle.
# Service rules use TLS SNI and therefore do not work when SNI is absent or protected by ECH.

# BitTorrent DHT: Suricata app-layer detector plus bencoded ping fallback.
alert udp any any -> any any (msg:"DPI|bt-dht|protocol"; app-layer-protocol:bittorrent-dht; sid:9500001; rev:1;)
alert udp any any -> any any (msg:"DPI|bt-dht|protocol"; content:"1:q4:ping"; content:"1:y1:q"; distance:0; within:48; sid:9500002; rev:1;)
# DNS over UDP/TCP via app-layer protocol detection.
alert udp any any -> any any (msg:"DPI|dns|protocol"; app-layer-protocol:dns; sid:9500003; rev:1;)
alert tcp any any -> any any (msg:"DPI|dns|protocol"; app-layer-protocol:dns; sid:9500004; rev:1;)
# FTP parser plus protocol banner fallback.
alert tcp any any -> any any (msg:"DPI|ftp|protocol"; app-layer-protocol:ftp; sid:9500005; rev:1;)
alert tcp any any -> any any (msg:"DPI|ftp|protocol"; flow:established; content:"220 "; startswith; content:"FTP"; nocase; distance:0; within:128; sid:9500006; rev:1;)
# HTTP automatic protocol detection, port-independent.
alert tcp any any -> any any (msg:"DPI|http|protocol"; app-layer-protocol:http; sid:9500007; rev:1;)
# IMAP detector plus explicit server banner fallback.
alert tcp any any -> any any (msg:"DPI|imap|protocol"; app-layer-protocol:imap; sid:9500008; rev:1;)
alert tcp any any -> any any (msg:"DPI|imap|protocol"; flow:established; content:"* OK "; startswith; content:"IMAP"; nocase; distance:0; within:128; sid:9500009; rev:1;)
# LDAP app-layer detector.
alert tcp any any -> any any (msg:"DPI|ldap|protocol"; app-layer-protocol:ldap; sid:9500010; rev:1;)
# MQTT parser plus CONNECT protocol-name fallback.
alert tcp any any -> any any (msg:"DPI|mqtt|protocol"; app-layer-protocol:mqtt; sid:9500011; rev:1;)
alert tcp any any -> any any (msg:"DPI|mqtt|protocol"; flow:established,to_server; content:"|00 04|MQTT"; depth:20; sid:9500012; rev:1;)
# NTP app-layer detector.
alert udp any any -> any any (msg:"DPI|ntp|protocol"; app-layer-protocol:ntp; sid:9500013; rev:1;)
# POP3 detector plus banner fallback.
alert tcp any any -> any any (msg:"DPI|pop3|protocol"; app-layer-protocol:pop3; sid:9500014; rev:1;)
alert tcp any any -> any any (msg:"DPI|pop3|protocol"; flow:established; content:"+OK "; startswith; content:"POP3"; nocase; distance:0; within:128; sid:9500015; rev:1;)
# RDP parser plus TPKT/X.224 Connection Request fallback.
alert tcp any any -> any any (msg:"DPI|rdp|protocol"; app-layer-protocol:rdp; sid:9500016; rev:1;)
alert tcp any any -> any any (msg:"DPI|rdp|protocol"; flow:established,to_server; content:"|03 00|"; offset:0; depth:2; content:"|E0|"; offset:5; depth:1; sid:9500017; rev:1;)
# SIP over UDP/TCP via parser plus compound INVITE fallback.
alert udp any any -> any any (msg:"DPI|sip|protocol"; app-layer-protocol:sip; sid:9500018; rev:1;)
alert tcp any any -> any any (msg:"DPI|sip|protocol"; app-layer-protocol:sip; sid:9500019; rev:1;)
alert udp any any -> any any (msg:"DPI|sip|protocol"; content:"INVITE "; startswith; content:" SIP/2.0|0D 0A|"; distance:0; within:512; content:"|0D 0A|Via:"; nocase; distance:0; within:1024; sid:9500020; rev:1;)
alert tcp any any -> any any (msg:"DPI|sip|protocol"; content:"INVITE "; startswith; content:" SIP/2.0|0D 0A|"; distance:0; within:512; content:"|0D 0A|Via:"; nocase; distance:0; within:1024; sid:9500021; rev:1;)
# SNMP app-layer detector.
alert udp any any -> any any (msg:"DPI|snmp|protocol"; app-layer-protocol:snmp; sid:9500022; rev:1;)
# Telnet detector plus IAC negotiation fallback.
alert tcp any any -> any any (msg:"DPI|telnet|protocol"; app-layer-protocol:telnet; sid:9500023; rev:1;)
alert tcp any any -> any any (msg:"DPI|telnet|protocol"; flow:established; content:"|FF FB 01|"; content:"|FF FB 03|"; distance:0; within:32; sid:9500024; rev:1;)
# Generic TLS parser detection.
alert tcp any any -> any any (msg:"DPI|tls|protocol"; app-layer-protocol:tls; sid:9500025; rev:1;)
# SSH parser plus RFC-style identification string fallback.
alert tcp any any -> any any (msg:"DPI|ssh|protocol"; app-layer-protocol:ssh; sid:9500026; rev:1;)
alert tcp any any -> any any (msg:"DPI|ssh|protocol"; flow:established; content:"SSH-2.0-"; startswith; sid:9500027; rev:1;)
# QUIC parser plus RFC 9000 long-header/version-1 invariant fallback.
alert udp any any -> any any (msg:"DPI|quic|protocol"; app-layer-protocol:quic; sid:9500028; rev:1;)
alert udp any any -> any any (msg:"DPI|quic|protocol"; pcre:"/^[\xC0-\xFF]\x00\x00\x00\x01/s"; sid:9500029; rev:1;)
# IEC 60870-5-104 U-frame control sequences.
alert tcp any any -> any any (msg:"DPI|iec104|protocol"; flow:established,to_server; content:"|68 04 07 00 00 00|"; startswith; sid:9500030; rev:1;)
alert tcp any any -> any any (msg:"DPI|iec104|protocol"; flow:established,to_server; content:"|68 04 13 00 00 00|"; startswith; sid:9500031; rev:1;)
# BGP marker plus OPEN/UPDATE message type at protocol-defined byte 18.
alert tcp any any -> any any (msg:"DPI|bgp|protocol"; flow:established; content:"|FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF|"; startswith; content:"|01|"; offset:18; depth:1; sid:9500032; rev:1;)
alert tcp any any -> any any (msg:"DPI|bgp|protocol"; flow:established; content:"|FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF|"; startswith; content:"|02|"; offset:18; depth:1; sid:9500033; rev:1;)
# BitTorrent peer handshake exact stream prefix.
alert tcp any any -> any any (msg:"DPI|bt-peer|protocol"; flow:established,to_server; content:"|13|BitTorrent protocol"; startswith; sid:9500034; rev:1;)
# PostgreSQL StartupMessage protocol 3.0 and user parameter.
alert tcp any any -> any any (msg:"DPI|postgresql|protocol"; flow:established,to_server; content:"|00 03 00 00|"; offset:4; depth:4; content:"user|00|"; distance:0; within:256; sid:9500035; rev:1;)
# RADIUS Access-Request with first User-Name attribute.
alert udp any any -> any any (msg:"DPI|radius|protocol"; content:"|01|"; offset:0; depth:1; content:"|01|"; offset:20; depth:1; sid:9500036; rev:1;)
# RTSP request/response requires RTSP version and CSeq header together.
alert tcp any any -> any any (msg:"DPI|rtsp|protocol"; flow:established,to_server; content:" RTSP/1.0|0D 0A|"; content:"|0D 0A|CSeq:"; nocase; distance:0; within:1024; sid:9500037; rev:1;)
alert tcp any any -> any any (msg:"DPI|rtsp|protocol"; flow:established,to_client; content:"RTSP/1.0 "; startswith; content:"|0D 0A|CSeq:"; nocase; distance:0; within:1024; sid:9500038; rev:1;)
# SAP Session Announcement carrying SDP.
alert udp any any -> any any (msg:"DPI|sap|protocol"; content:"application/sdp|00|"; content:"v=0|0D 0A|"; distance:0; within:64; sid:9500039; rev:1;)
# Syslog RFC 5424/RFC 3164 anchored starts over UDP and TCP.
alert udp any any -> any any (msg:"DPI|syslog|protocol"; pcre:"/^<[0-9]{1,3}>1 /"; sid:9500040; rev:1;)
alert tcp any any -> any any (msg:"DPI|syslog|protocol"; flow:established; pcre:"/^<[0-9]{1,3}>1 /"; sid:9500041; rev:1;)
alert udp any any -> any any (msg:"DPI|syslog|protocol"; pcre:"/^<[0-9]{1,3}>[A-Z][a-z]{2} [ 0-9][0-9] /"; sid:9500042; rev:1;)
alert tcp any any -> any any (msg:"DPI|syslog|protocol"; flow:established; pcre:"/^<[0-9]{1,3}>[A-Z][a-z]{2} [ 0-9][0-9] /"; sid:9500043; rev:1;)
# STUN RFC 5389 magic cookie at fixed offset 4.
alert udp any any -> any any (msg:"DPI|stun|protocol"; content:"|21 12 A4 42|"; offset:4; depth:4; sid:9500044; rev:1;)
# DTLS 1.2/1.0 handshake record plus ClientHello type.
alert udp any any -> any any (msg:"DPI|dtls|protocol"; content:"|16 FE FD|"; offset:0; depth:3; content:"|01|"; offset:13; depth:1; sid:9500045; rev:1;)
alert udp any any -> any any (msg:"DPI|dtls|protocol"; content:"|16 FE FF|"; offset:0; depth:3; content:"|01|"; offset:13; depth:1; sid:9500046; rev:1;)
# OPC UA Hello message and OPC Classic IOPCServer interface UUID.
alert tcp any any -> any any (msg:"DPI|opc|protocol"; flow:established; content:"HELF"; startswith; sid:9500047; rev:1;)
alert tcp any any -> any any (msg:"DPI|opc|protocol"; flow:established; content:"|4D 3A C1 39 1E 01 D0 11 96 75 00 20 AF D8 AD B3|"; sid:9500048; rev:1;)
alert udp any any -> any any (msg:"DPIHELPER|openvpn|udp-v2-client-reset"; flow:to_server; content:"|38|"; offset:0; depth:1; flowbits:set,dpi.openvpn.reset; noalert; sid:9500049; rev:1;)
alert udp any any -> any any (msg:"DPIHELPER|openvpn|udp-v3-client-reset"; flow:to_server; content:"|50|"; offset:0; depth:1; flowbits:set,dpi.openvpn.reset; noalert; sid:9500050; rev:1;)
# OpenVPN UDP hard-reset client/server handshake.
alert udp any any -> any any (msg:"DPI|openvpn|protocol"; flow:to_client; flowbits:isset,dpi.openvpn.reset; content:"|40|"; offset:0; depth:1; sid:9500051; rev:1;)
alert tcp any any -> any any (msg:"DPIHELPER|openvpn|tcp-v2-client-reset"; flow:established,to_server; content:"|38|"; offset:2; depth:1; flowbits:set,dpi.openvpn.tcp.reset; noalert; sid:9500052; rev:1;)
alert tcp any any -> any any (msg:"DPIHELPER|openvpn|tcp-v3-client-reset"; flow:established,to_server; content:"|50|"; offset:2; depth:1; flowbits:set,dpi.openvpn.tcp.reset; noalert; sid:9500053; rev:1;)
# OpenVPN TCP length-framed hard-reset handshake.
alert tcp any any -> any any (msg:"DPI|openvpn|protocol"; flow:established,to_client; flowbits:isset,dpi.openvpn.tcp.reset; content:"|40|"; offset:2; depth:1; sid:9500054; rev:1;)
# Exchange/Outlook service endpoints.
alert tls any any -> any any (msg:"DPI|outlook|service"; flow:established,to_server; tls.sni; content:"outlook.office.com"; nocase; endswith; pcre:"/(?:^|\.)outlook\.office\.com$/i"; sid:9500055; rev:1;)
alert tls any any -> any any (msg:"DPI|outlook|service"; flow:established,to_server; tls.sni; content:"outlook.office365.com"; nocase; endswith; pcre:"/(?:^|\.)outlook\.office365\.com$/i"; sid:9500056; rev:1;)
# Facebook mobile chat MQTT endpoints; intentionally not all facebook.com.
alert tls any any -> any any (msg:"DPI|facebook-chat|service"; flow:established,to_server; tls.sni; content:"edge-mqtt.facebook.com"; nocase; endswith; pcre:"/(?:^|\.)edge\-mqtt\.facebook\.com$/i"; sid:9500057; rev:1;)
alert tls any any -> any any (msg:"DPI|facebook-chat|service"; flow:established,to_server; tls.sni; content:"mqtt-mini.facebook.com"; nocase; endswith; pcre:"/(?:^|\.)mqtt\-mini\.facebook\.com$/i"; sid:9500058; rev:1;)
# Google Mail service domains.
alert tls any any -> any any (msg:"DPI|gmail|service"; flow:established,to_server; tls.sni; content:"gmail.com"; nocase; endswith; pcre:"/(?:^|\.)gmail\.com$/i"; sid:9500059; rev:1;)
alert tls any any -> any any (msg:"DPI|gmail|service"; flow:established,to_server; tls.sni; content:"mail.google.com"; nocase; endswith; pcre:"/(?:^|\.)mail\.google\.com$/i"; sid:9500060; rev:1;)
# Microsoft Azure signup endpoint.
alert tls any any -> any any (msg:"DPI|azure-signup|service"; flow:established,to_server; tls.sni; content:"signup.azure.com"; nocase; endswith; pcre:"/(?:^|\.)signup\.azure\.com$/i"; sid:9500061; rev:1;)
# Microsoft/Windows Update documented endpoint families.
alert tls any any -> any any (msg:"DPI|microsoft-update|service"; flow:established,to_server; tls.sni; content:"windowsupdate.com"; nocase; endswith; pcre:"/(?:^|\.)windowsupdate\.com$/i"; sid:9500062; rev:1;)
alert tls any any -> any any (msg:"DPI|microsoft-update|service"; flow:established,to_server; tls.sni; content:"update.microsoft.com"; nocase; endswith; pcre:"/(?:^|\.)update\.microsoft\.com$/i"; sid:9500063; rev:1;)
alert tls any any -> any any (msg:"DPI|microsoft-update|service"; flow:established,to_server; tls.sni; content:"delivery.mp.microsoft.com"; nocase; endswith; pcre:"/(?:^|\.)delivery\.mp\.microsoft\.com$/i"; sid:9500064; rev:1;)
# Netflix control/video/image endpoint families.
alert tls any any -> any any (msg:"DPI|netflix|service"; flow:established,to_server; tls.sni; content:"netflix.com"; nocase; endswith; pcre:"/(?:^|\.)netflix\.com$/i"; sid:9500065; rev:1;)
alert tls any any -> any any (msg:"DPI|netflix|service"; flow:established,to_server; tls.sni; content:"nflxvideo.net"; nocase; endswith; pcre:"/(?:^|\.)nflxvideo\.net$/i"; sid:9500066; rev:1;)
alert tls any any -> any any (msg:"DPI|netflix|service"; flow:established,to_server; tls.sni; content:"nflximg.net"; nocase; endswith; pcre:"/(?:^|\.)nflximg\.net$/i"; sid:9500067; rev:1;)
# Skype service domains.
alert tls any any -> any any (msg:"DPI|skype|service"; flow:established,to_server; tls.sni; content:"skype.com"; nocase; endswith; pcre:"/(?:^|\.)skype\.com$/i"; sid:9500068; rev:1;)
alert tls any any -> any any (msg:"DPI|skype|service"; flow:established,to_server; tls.sni; content:"skype.net"; nocase; endswith; pcre:"/(?:^|\.)skype\.net$/i"; sid:9500069; rev:1;)
# TeamViewer service domains.
alert tls any any -> any any (msg:"DPI|teamviewer|service"; flow:established,to_server; tls.sni; content:"teamviewer.com"; nocase; endswith; pcre:"/(?:^|\.)teamviewer\.com$/i"; sid:9500070; rev:1;)
alert tls any any -> any any (msg:"DPI|teamviewer|service"; flow:established,to_server; tls.sni; content:"teamviewerapi.com"; nocase; endswith; pcre:"/(?:^|\.)teamviewerapi\.com$/i"; sid:9500071; rev:1;)
# Cisco Webex service domains.
alert tls any any -> any any (msg:"DPI|webex|service"; flow:established,to_server; tls.sni; content:"webex.com"; nocase; endswith; pcre:"/(?:^|\.)webex\.com$/i"; sid:9500072; rev:1;)
alert tls any any -> any any (msg:"DPI|webex|service"; flow:established,to_server; tls.sni; content:"wbx2.com"; nocase; endswith; pcre:"/(?:^|\.)wbx2\.com$/i"; sid:9500073; rev:1;)
# YouTube control/video/static endpoint families.
alert tls any any -> any any (msg:"DPI|youtube|service"; flow:established,to_server; tls.sni; content:"youtube.com"; nocase; endswith; pcre:"/(?:^|\.)youtube\.com$/i"; sid:9500074; rev:1;)
alert tls any any -> any any (msg:"DPI|youtube|service"; flow:established,to_server; tls.sni; content:"googlevideo.com"; nocase; endswith; pcre:"/(?:^|\.)googlevideo\.com$/i"; sid:9500075; rev:1;)
alert tls any any -> any any (msg:"DPI|youtube|service"; flow:established,to_server; tls.sni; content:"ytimg.com"; nocase; endswith; pcre:"/(?:^|\.)ytimg\.com$/i"; sid:9500076; rev:1;)
