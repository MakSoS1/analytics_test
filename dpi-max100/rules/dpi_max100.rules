# RTSP parsed through LibHTP: classify using the parsed protocol field, not generic HTTP.
alert http any any -> any any (msg:"DPI|rtsp|protocol"; flow:established,to_server; http.protocol; content:"RTSP/1.0"; startswith; endswith; sid:9500173; rev:1;)
alert http any any -> any any (msg:"DPI|rtsp|protocol"; flow:established,to_client; http.protocol; content:"RTSP/1.0"; startswith; endswith; sid:9500174; rev:1;)
