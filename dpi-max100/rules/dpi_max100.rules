alert tls any any -> any any (msg:"DPI|gmail|service"; flow:established,to_server; tls.sni; content:"imap.gmail.com"; nocase; endswith; pcre:"/(?:^|\.)imap\.gmail\.com$/i"; sid:9500154; rev:1;)
