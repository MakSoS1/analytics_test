alert http any any -> any any (msg:"DPI|outlook|service"; flow:established,to_server; http.host; pcre:"/(?:^|\.)(?:outlook\.com|outlook\.office\.com|outlook\.office365\.com)$/i"; sid:9500163; rev:1;)
